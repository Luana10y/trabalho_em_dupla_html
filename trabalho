<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Exemplo de HTML Semântico</title>
</head>
<body>

  <!-- Cabeçalho principal da página -->
  <header>
    <h1>Meu Site Semântico</h1>
    <nav>
      <ul>
        <li><a href="#inicio">Início</a></li>
        <li><a href="#sobre">Sobre</a></li>
        <li><a href="#contato">Contato</a></li>
      </ul>
    </nav>
  </header>

  <!-- Conteúdo principal -->
  <main>
    <section id="inicio">
      <h2>Bem-vindo</h2>
      <article>
        <h3>Artigo em destaque</h3>
        <p>Este é um exemplo de conteúdo independente e auto-contido.</p>
      </article>
    </section>

    <!-- Barra lateral com informações complementares -->
    <aside>
      <h3>Saiba mais</h3>
      <p>Conteúdos relacionados ou propagandas ficam bem aqui.</p>
    </aside>
  </main>

  <!-- Rodapé da página -->
  <footer>
    <p>&copy; 2026 - Todos os direitos reservados.</p>
  </footer>

</body>
</html>



